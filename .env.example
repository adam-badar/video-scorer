# Video Scorer API — Environment Variables
# All prefixed with VIDEO_SCORER_ (pydantic-settings convention)

# API authentication (shared secret with Bavlio-Admin proxy)
VIDEO_SCORER_API_KEY=your-32-byte-shared-secret-here

# Deepgram Nova-3 for transcription (optional — graceful degradation without it)
VIDEO_SCORER_DEEPGRAM_API_KEY=your-deepgram-key

# Gemini 2.5 Pro for qualitative analysis (optional)
VIDEO_SCORER_GEMINI_API_KEY=your-gemini-key

# Supabase — service key for writing to video_scorecards
VIDEO_SCORER_SUPABASE_URL=https://fgdvuqqucvfxclfflffg.supabase.co
VIDEO_SCORER_SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# SSRF guard — only allow downloads from this URL prefix
VIDEO_SCORER_ALLOWED_URL_PREFIX=https://fgdvuqqucvfxclfflffg.supabase.co/storage/v1/object/public/post-media/
